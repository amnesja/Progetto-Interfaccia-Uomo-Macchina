@model Ordo.Web.Features.Registrazione.RegistrazioneViewModel
@{
    ViewData["Title"] = "Registrazione";
}
<div class="container">
    <form method="post" role="form" autocomplete="off">

        <div class="form-group">
            <label asp-for="Email" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="Email" class="form-control" type="text" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="Password" class="form-control" type="password" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfermaPassword" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="ConfermaPassword" class="form-control" type="password" />
            </div>
            <span asp-validation-for="ConfermaPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FirstName" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="FirstName" class="form-control" type="text" />
            </div>
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="LastName" class="form-control" type="text" />
            </div>
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="NickName" class="onit-label-required"></label>
            <div class="input-group onit-input-group-union">
                <input asp-for="NickName" class="form-control" type="text" />
            </div>
            <span asp-validation-for="NickName" class="text-danger"></span>
        </div>

        <div class="form-group text-center mt-4">
            <button type="submit" class="btn btn-primary">Registrati</button>
        </div>
    </form>
</div>