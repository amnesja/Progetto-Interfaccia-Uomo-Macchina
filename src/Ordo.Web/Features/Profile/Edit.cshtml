@model ProfileEditViewModel
@{
    Layout = "_ProfileLayout";
    ViewData["Title"] = "Modifica profilo";
}

<div class="ordo-profile-page">
    <a class="ordo-back-link" href="/Profile"><i class="fa-solid fa-arrow-left"></i> Torna al profilo</a>
    <h1>Modifica profilo</h1>

    <form class="ordo-profile-form" method="post">
        <div class="ordo-field">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="field-validation-error"></span>
        </div>
        <div class="ordo-field">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="field-validation-error"></span>
        </div>
        <div class="ordo-field">
            <label asp-for="NickName"></label>
            <input asp-for="NickName" autocomplete="username" />
            <span asp-validation-for="NickName" class="field-validation-error"></span>
        </div>
        <div class="ordo-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" readonly aria-describedby="email-help" />
            <small id="email-help">L'indirizzo email non è modificabile.</small>
        </div>
        <div class="ordo-profile-form-actions">
            <a asp-controller="Profile" asp-action="Profile">Annulla</a>
            <button type="submit">Salva modifiche</button>
        </div>
    </form>
</div>
