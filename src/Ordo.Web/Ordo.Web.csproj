<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="SG4MVC" Version="0.9.4-beta" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.11" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="Sg4Mvc.GenerateSg4Mvc" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ordo\Ordo.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11" />
	</ItemGroup>

	<ItemGroup>
	  <_ContentIncludedByDefault Remove="Areas\Progetti\Dettaglio.cshtml" />
	  <_ContentIncludedByDefault Remove="Areas\Progetti\Edit.cshtml" />
	  <_ContentIncludedByDefault Remove="Areas\Progetti\Index.cshtml" />
	</ItemGroup>

	<Target Name="RestoreNpmPackages"
        BeforeTargets="Build"
        Condition="!Exists('node_modules\.bin\tsc.cmd')">
		<Message Text="Ripristino pacchetti npm in corso..." Importance="high" />
		<Exec Command="npm install" />
	</Target>

	<ItemGroup>
		<TypeScriptSource Include="**\*.ts" Exclude="node_modules\**;bin\**;obj\**" />
	</ItemGroup>

	<Target Name="CompileTypeScript"
			BeforeTargets="Build"
			DependsOnTargets="RestoreNpmPackages"
			Inputs="@(TypeScriptSource)"
			Outputs="$(IntermediateOutputPath)tsc.buildmarker">
		<Message Text="Compilazione TypeScript in corso..." Importance="high" />
		<Exec Command="npx tsc -p tsconfig.json" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Touch Files="$(IntermediateOutputPath)tsc.buildmarker" AlwaysCreate="true" />
	</Target>

</Project>
