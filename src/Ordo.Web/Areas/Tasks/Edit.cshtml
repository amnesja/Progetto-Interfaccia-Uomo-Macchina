@model Ordo.Web.Areas.Tasks.EditViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.Id.HasValue ? "Modifica task" : "Nuovo task";
}

@section styles {
    <link href="~/css/progetti.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/tasks.css" asp-append-version="true" rel="stylesheet" />
}

<div class="ordo-projects-page ordo-projects-page-narrow">
    <a class="ordo-back-link" asp-area="Kanban" asp-controller="Kanban" asp-action="Board" asp-route-id="@Model.BoardId">
        <i class="fa-solid fa-arrow-left"></i> Torna alla board
    </a>
    <h1>@ViewData["Title"]</h1>

    <form class="ordo-project-form" method="post" action="@Url.Action(MVC.Tasks.Tasks.Edit())">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="BoardId" />
        <input type="hidden" asp-for="ProjectId" />
        <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>

        <div class="ordo-field">
            <label asp-for="Titolo"></label>
            <input asp-for="Titolo" autocomplete="off" />
            <span asp-validation-for="Titolo" class="field-validation-error"></span>
        </div>

        <div class="ordo-field">
            <label asp-for="Descrizione"></label>
            <textarea asp-for="Descrizione" rows="4"></textarea>
        </div>

        <div class="ordo-field-row">
            <div class="ordo-field">
                <label asp-for="Priorita"></label>
                <select asp-for="Priorita" asp-items="Model.PrioritaOptions"></select>
            </div>
            <div class="ordo-field">
                <label asp-for="Scadenza"></label>
                <input asp-for="Scadenza" id="task-due-date" type="date" />
            </div>
        </div>

        <div class="ordo-field">
            <label asp-for="AssignedUserId"></label>
            <select asp-for="AssignedUserId" asp-items="Model.UtentiAssegnabili">
                <option value="">Nessuna assegnazione</option>
            </select>
        </div>

        <div class="ordo-project-form-actions">
            @if (Model.Id.HasValue)
            {
                <button type="button" class="ordo-link-danger" id="delete-task-button">
                    Elimina task
                </button>
            }
            <a asp-area="Kanban" asp-controller="Kanban" asp-action="Board" asp-route-id="@Model.BoardId">Annulla</a>
            <button type="submit">Salva</button>
        </div>
    </form>

    @if (Model.Id.HasValue)
    {
        <form id="delete-form" hidden method="post" action="@Url.Action(MVC.Tasks.Tasks.Delete())"
              >
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="boardId" value="@Model.BoardId" />
        </form>

        <div id="delete-task-modal" class="ordo-modal-backdrop" hidden>
            <section class="ordo-modal" role="dialog" aria-modal="true" aria-labelledby="delete-task-modal-title"
                     aria-describedby="delete-task-modal-description">
                <header class="ordo-modal-header">
                    <h2 id="delete-task-modal-title">Eliminare il task?</h2>
                    <button type="button" class="ordo-modal-close" id="cancel-delete-task-close"
                            aria-label="Chiudi">&times;</button>
                </header>
                <div class="ordo-modal-form">
                    <p id="delete-task-modal-description">
                        Il task e tutti i suoi commenti verranno eliminati definitivamente.
                    </p>
                    <div class="ordo-project-form-actions">
                        <button type="button" class="ordo-btn-secondary" id="cancel-delete-task">Annulla</button>
                        <button type="button" class="ordo-link-danger" id="confirm-delete-task">Elimina task</button>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@section scripts {
    <script>
        (function () {
            const dueDateInput = document.getElementById("task-due-date");

            dueDateInput?.addEventListener("click", function () {
                if (!window.matchMedia("(max-width: 640px)").matches || typeof dueDateInput.showPicker !== "function") {
                    return;
                }

                try {
                    dueDateInput.showPicker();
                } catch {
                    // Il browser userà il comportamento nativo predefinito.
                }
            });

            const deleteButton = document.getElementById("delete-task-button");
            const deleteForm = document.getElementById("delete-form");
            const deleteModal = document.getElementById("delete-task-modal");
            const cancelDeleteButtons = document.querySelectorAll("#cancel-delete-task, #cancel-delete-task-close");

            function closeDeleteModal() {
                if (deleteModal) {
                    deleteModal.hidden = true;
                }
            }

            deleteButton?.addEventListener("click", function () {
                if (deleteModal) {
                    deleteModal.hidden = false;
                    document.getElementById("cancel-delete-task")?.focus();
                }
            });

            cancelDeleteButtons.forEach(function (button) {
                button.addEventListener("click", closeDeleteModal);
            });

            deleteModal?.addEventListener("click", function (event) {
                if (event.target === deleteModal) {
                    closeDeleteModal();
                }
            });

            document.getElementById("confirm-delete-task")?.addEventListener("click", function () {
                deleteForm?.submit();
            });
        })();
    </script>
}
