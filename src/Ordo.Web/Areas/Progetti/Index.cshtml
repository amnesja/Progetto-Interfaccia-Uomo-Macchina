@model Ordo.Web.Areas.Progetti.IndexViewModel
@using System.Security.Claims
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "I miei progetti";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section styles {
    <link href="~/css/dashboard.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/progetti.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/signalr-banner.css" asp-append-version="true" rel="stylesheet" />
}

<div class="ordo-projects-page">
    <div id="lostConnection" class="ordo-signalr-banner d-none">
        <i class="fa-solid fa-triangle-exclamation"></i> Connessione in tempo reale persa, riconnessione in corso...
    </div>
    <div id="lostConnectionManualRetry" class="ordo-signalr-banner ordo-signalr-banner-error d-none">
        <i class="fa-solid fa-plug-circle-xmark"></i> Impossibile riconnettersi.
        <a href="javascript:location.reload()">Ricarica la pagina</a>
    </div>
    <header class="ordo-projects-heading">
        <div>
            <h1>Progetti</h1>
            <p>Trova rapidamente un progetto e apri il suo spazio di lavoro.</p>
        </div>
        <a class="ordo-btn-primary" href="@Url.Action(MVC.Progetti.Progetti.New())">
            <i class="fa-solid fa-plus"></i> Nuovo progetto
        </a>
    </header>

    <form class="ordo-projects-search ordo-projects-toolbar" method="get">
        <div class="ordo-search ordo-search-large">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input asp-for="Filter" placeholder="Cerca un progetto..." />
        </div>
        <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Cerca</button>
        @if (!string.IsNullOrWhiteSpace(Model.Filter))
        {
            <a class="ordo-clear-search" href="@Url.Action(MVC.Progetti.Progetti.Index())">Azzera</a>
        }
    </form>

    @if (!Model.Progetti.Any())
    {
        <div class="ordo-dashboard-empty">
            Nessun progetto trovato. Crea il tuo primo progetto per iniziare.
        </div>
    }
    else
    {
        <div class="ordo-project-grid">
            @foreach (var progetto in Model.Progetti)
            {
                <article class="ordo-project-card ordo-project-card-rich">
                    <a class="ordo-project-card-link" href="@Url.Action(MVC.Progetti.Progetti.Dettaglio(progetto.Id))">
                        <div class="ordo-project-card-title"><span class="ordo-project-icon"><i class="fa-regular fa-folder-open"></i></span><h3>@progetto.Nome</h3></div>
                        @if (!progetto.IsOwner)
                        {
                            <span class="ordo-role-badge">Collaboratore</span>
                        }
                        <p>@(string.IsNullOrWhiteSpace(progetto.Descrizione) ? "Nessuna descrizione." : progetto.Descrizione)</p>
                    </a>

                    @* Mostra le azioni di gestione solo se l'utente è Owner *@
                    @if (progetto.IsOwner)
                    {
                        <footer>
                            <a href="@Url.Action(MVC.Progetti.Progetti.Edit(progetto.Id))" title="Modifica progetto">
                                <i class="fa-solid fa-pen"></i> Modifica
                            </a>
                            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.Delete())"
                                  onsubmit="return confirm('Eliminare definitivamente questo progetto e tutte le sue board?');">
                                <input type="hidden" name="id" value="@progetto.Id" />
                                <button type="submit" class="ordo-link-danger"><i class="fa-solid fa-trash"></i> Elimina</button>
                            </form>
                        </footer>
                    }
                </article>
            }
        </div>

        @if (Model.TotalPages() > 1)
        {
            <nav class="ordo-pagination">
                <a class="@(Model.Page <= 1 ? "disabled" : "")" href="@Model.PrevPageUrl(Url)">&laquo; Precedente</a>
                <span>Pagina @Model.Page di @Model.TotalPages()</span>
                <a class="@(Model.Page >= Model.TotalPages() ? "disabled" : "")" href="@Model.NextPageUrl(Url)">Successiva &raquo;</a>
            </nav>
        }
    }
</div>

@section scripts {
    <script src="/js/bundle-signalr.js" asp-append-version="true"></script>
    <script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>
    <script>
        var signalRManager = new SignalRConnectionManager("/OrdoHub", "@currentUserId", "JoinGroup", "LeaveGroup");
        signalRManager.registerEvents();

        signalRManager.connection.on("ProjectMemberAdded", function (projectId, nome) {
            ordoNotify("Sei stato aggiunto al progetto «" + nome + "».", "/Progetti/Dettaglio/" + projectId, "project", 1200, function () { location.reload(); });
        });
        signalRManager.connection.on("ProjectDeleted", function (projectId) {
            ordoNotify("Un progetto non è più disponibile.", null, "project", 1200, function () { location.reload(); });
        });
        signalRManager.connection.on("ProjectUpdated", function (projectId, nome) {
            ordoNotify("Il progetto «" + nome + "» è stato aggiornato.", "/Progetti/Dettaglio/" + projectId, "project", 1200, function () { location.reload(); });
        });
        window.addEventListener("ordo:signalr-reconnected", function () { location.reload(); });
        signalRManager.startConnection();
    </script>
}