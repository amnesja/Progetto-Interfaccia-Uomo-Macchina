@model Ordo.Web.Areas.Progetti.ChatViewModel
@using System.Security.Claims
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Chat - " + Model.ProjectNome;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section styles {
    <link href="~/css/progetti.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/signalr-banner.css" asp-append-version="true" rel="stylesheet" />
}

<div class="ordo-projects-page ordo-projects-page-narrow">
    <div id="lostConnection" class="ordo-signalr-banner d-none">
        <i class="fa-solid fa-triangle-exclamation"></i> Connessione in tempo reale persa, riconnessione in corso...
    </div>
    <div id="lostConnectionManualRetry" class="ordo-signalr-banner ordo-signalr-banner-error d-none">
        <i class="fa-solid fa-plug-circle-xmark"></i> Impossibile riconnettersi.
        <a href="javascript:location.reload()">Ricarica la pagina</a>
    </div>

    <a class="ordo-back-link" asp-action="Dettaglio" asp-route-id="@Model.ProjectId">
        <i class="fa-solid fa-arrow-left"></i> Torna al progetto
    </a>
    <header class="ordo-project-detail-heading">
        <div>
            <span class="ordo-eyebrow">Chat del progetto</span>
            <h1>@Model.ProjectNome</h1>
            <p>Conversazione con i collaboratori del progetto.</p>
        </div>
    </header>

    <section class="ordo-project-chat" aria-label="Messaggi della chat">
        <div id="chatMessages" class="ordo-chat-messages">
            @if (!Model.Messages.Any())
            {
                <p class="ordo-dashboard-empty">Nessun messaggio. Inizia la conversazione.</p>
            }
            @foreach (var message in Model.Messages)
            {
                <article class="ordo-chat-message @(message.UserId.ToString() == currentUserId ? "mine" : "")">
                    <header><strong>@message.UserName</strong><time>@message.DataCreazione.ToLocalTime().ToString("dd/MM HH:mm")</time></header>
                    <p>@message.Testo</p>
                </article>
            }
        </div>
        <form method="post" asp-action="ChatInvia" class="ordo-chat-form">
            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
            <textarea name="Testo" maxlength="2000" rows="3" placeholder="Scrivi un messaggio..." required></textarea>
            <button class="ordo-btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Invia</button>
        </form>
    </section>
</div>

@section scripts {
    <script src="/js/bundle-signalr.js" asp-append-version="true"></script>
    <script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>
    <script>
        var signalRManager = new SignalRConnectionManager("/OrdoHub", "@Model.ProjectId", "JoinGroup", "LeaveGroup");
        signalRManager.registerEvents();
        signalRManager.connection.on("ProjectChatMessageAdded", function (message) {
            showSignalRMessage("Nuovo messaggio da " + message.userName + ".", 1200, function () { location.reload(); });
        });
        window.addEventListener("ordo:signalr-reconnected", function () { location.reload(); });
        signalRManager.startConnection();
    </script>
}
