@model Ordo.Web.Areas.Progetti.DettaglioViewModel
@using System.Security.Claims
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.Nome;
    ViewData["BreadcrumbProjectId"] = Model.Id;
    ViewData["BreadcrumbProjectName"] = Model.Nome;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrWhiteSpace(activeTab))
    {
        activeTab = Model.Boards.Any() ? "board" : "overview";
    }
}

@section styles {
    <link href="~/css/progetti.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/kanban.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/signalr-banner.css" asp-append-version="true" rel="stylesheet" />
}

<div id="projectWorkspace" class="ordo-project-workspace" v-cloak>
    <div id="lostConnection" class="ordo-signalr-banner d-none">
        <i class="fa-solid fa-triangle-exclamation"></i> Connessione in tempo reale persa, riconnessione in corso...
    </div>
    <div id="lostConnectionManualRetry" class="ordo-signalr-banner ordo-signalr-banner-error d-none">
        <i class="fa-solid fa-plug-circle-xmark"></i> Impossibile riconnettersi.
        <a href="javascript:location.reload()">Ricarica la pagina</a>
    </div>
    @Html.AntiForgeryToken()

    <a class="ordo-back-link" href="@Url.Action(MVC.Progetti.Progetti.Index())">
        <i class="fa-solid fa-arrow-left"></i> Progetti
    </a>

    <header class="ordo-project-workspace-header">
        <div>
            <h1>@Model.Nome</h1>
            <p>@(string.IsNullOrWhiteSpace(Model.Descrizione) ? "Workspace del progetto." : Model.Descrizione)</p>
        </div>
        <div class="ordo-project-workspace-actions">
            @if (Model.IsOwner)
            {
                <a class="ordo-btn-secondary" href="@Url.Action(MVC.Progetti.Progetti.Edit(Model.Id))">
                    <i class="fa-solid fa-pen"></i> Modifica
                </a>
            }
        </div>
    </header>

    <nav class="ordo-project-nav" aria-label="Navigazione progetto">
        <button type="button" :class="{ active: activeTab === 'overview' }" @@click="selectTab('overview')">Panoramica</button>
        <button type="button" :class="{ active: activeTab === 'board' }" @@click="selectTab('board')">Board</button>
        <button type="button" :class="{ active: activeTab === 'people' }" @@click="selectTab('people')">Persone</button>
        <button type="button" :class="{ active: activeTab === 'chat' }" @@click="selectTab('chat')">Chat</button>
    </nav>

    <section v-show="activeTab === 'overview'" class="ordo-workspace-panel">
        <div class="ordo-workspace-panel-heading">
            <div>
                <h2>Panoramica</h2>
                <p>Una sintesi del lavoro e delle persone che collaborano al progetto.</p>
            </div>
            <button v-if="boards.length" type="button" class="ordo-btn-primary" @@click="selectTab('board')">
                <i class="fa-solid fa-table-columns"></i> Apri board
            </button>
        </div>
        <div class="ordo-workspace-summary">
            <article><strong>{{ boards.length }}</strong><span>Board</span></article>
            <article><strong>{{ totalTasks }}</strong><span>Attività</span></article>
            <article><strong>{{ members.length + 1 }}</strong><span>Persone</span></article>
            <article><strong>{{ messages.length }}</strong><span>Messaggi</span></article>
        </div>
        @if (Model.IsOwner)
        {
            <details class="ordo-workspace-settings">
                <summary><i class="fa-solid fa-gear"></i> Impostazioni progetto</summary>
                <form class="ordo-project-form ordo-project-inline-form" method="post" action="@Url.Action(MVC.Progetti.Progetti.Edit())">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="ordo-field">
                        <label for="workspaceProjectName">Nome progetto</label>
                        <input id="workspaceProjectName" name="Nome" value="@Model.Nome" required autocomplete="off" />
                    </div>
                    <div class="ordo-field">
                        <label for="workspaceProjectDescription">Descrizione</label>
                        <textarea id="workspaceProjectDescription" name="Descrizione" rows="3">@Model.Descrizione</textarea>
                    </div>
                    <button type="submit" class="ordo-btn-primary">Salva modifiche</button>
                </form>
            </details>
        }
        <div v-if="!boards.length" class="ordo-dashboard-empty">
            Crea la prima board per iniziare a organizzare il lavoro.
        </div>
    </section>

    <section v-show="activeTab === 'board'" class="ordo-workspace-panel">
        <div class="ordo-workspace-panel-heading">
            <div>
                <h2>Board</h2>
                <p>La vista operativa del progetto.</p>
            </div>
            <div v-if="boards.length" class="ordo-kanban-actions">
                <button type="button" class="ordo-btn-primary" @@click="openNewTask">
                    <i class="fa-solid fa-plus"></i> Nuova attività
                </button>
            </div>
        </div>

        <div v-if="!boards.length" class="ordo-dashboard-empty">
            La board non è ancora disponibile.
        </div>
        <template v-else>
            <div class="ordo-kanban-filters">
                <label class="ordo-kanban-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input v-model.trim="filters.search" type="search" placeholder="Cerca attività..." />
                </label>
                <select v-model="filters.state" aria-label="Filtra per stato">
                    <option value="">Tutti gli stati</option>
                    <option v-for="column in columns" :value="String(column.stato)">{{ column.titolo }}</option>
                </select>
                <select v-model="filters.priority" aria-label="Filtra per priorità">
                    <option value="">Tutte le priorità</option>
                    <option value="0">Bassa</option>
                    <option value="1">Media</option>
                    <option value="2">Alta</option>
                </select>
                <select v-model="filters.assignee" aria-label="Filtra per assegnatario">
                    <option value="">Tutti gli assegnatari</option>
                    <option v-for="member in members" :value="member.userId">{{ member.nomeCompleto }}</option>
                </select>
                <button type="button" class="ordo-filter-reset" @@click="resetFilters">Azzera</button>
            </div>
            <div class="kanban-board ordo-workspace-kanban">
                <div v-for="column in columns" :key="column.stato" class="kanban-column"
                     @@dragover.prevent @@drop="dropTask(column.stato)">
                    <div class="kanban-column-header">
                        <span>{{ column.titolo }}</span>
                        <span class="kanban-count">{{ tasksByState(column.stato).length }}</span>
                    </div>
                    <div class="kanban-column-body">
                        <article v-for="task in filteredTasksByState(column.stato)" :key="task.id"
                                 class="kanban-card" draggable="true"
                             @@click="handleCardClick(task)"
                             @@dragstart="startDragging(task)"
                             @@dragend="endDragging"
                             v-on:dragover.prevent
                             v-on:drop.stop="dropTaskOnTask(task)">
                            <div class="kanban-card-priority" :class="'priority-' + task.priorita"></div>
                            <div class="kanban-task-title"><b>{{ task.titolo }}</b></div>
                            <div v-if="task.scadenza" class="kanban-card-meta">
                                <i class="fa-regular fa-clock"></i> {{ formatDate(task.scadenza) }}
                            </div>
                            <div v-if="task.assignedUserName" class="kanban-card-assignee">{{ task.assignedUserName }}</div>
                        </article>
                    </div>
                </div>
            </div>
            <p v-if="!filteredTaskCount" class="ordo-dashboard-empty ordo-kanban-empty-filter">Nessuna attività corrisponde ai filtri.</p>
        </template>
    </section>

    <section v-show="activeTab === 'people'" class="ordo-workspace-panel">
        <div class="ordo-workspace-panel-heading">
            <div>
                <h2>Persone</h2>
                <p>Gestisci chi ha accesso a questo progetto.</p>
            </div>
        </div>
        <div class="ordo-board-list">
            <div v-for="member in members" :key="member.userId" class="ordo-board-row">
                <div class="ordo-member-info">
                    <span class="ordo-member-avatar">{{ member.nomeCompleto.substring(0, 1).toUpperCase() }}</span>
                    <div><strong>{{ member.nomeCompleto }}</strong><small>{{ member.email }}</small></div>
                </div>
                @if (Model.IsOwner)
                {
                    <form v-if="member.userId !== ownerId" method="post" action="@Url.Action(MVC.Progetti.Progetti.MembroRimuovi())">
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <input type="hidden" name="userId" :value="member.userId" />
                        <button type="submit" class="ordo-link-danger" title="Rimuovi collaboratore"><i class="fa-solid fa-user-minus"></i></button>
                    </form>
                }
            </div>
        </div>
        @if (Model.IsOwner)
        {
            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.MembroAggiungi())" class="ordo-board-add-form">
                <input type="hidden" name="ProjectId" value="@Model.Id" />
                <input type="email" name="Email" placeholder="Email del collaboratore da invitare" autocomplete="off" required />
                <button type="submit"><i class="fa-solid fa-user-plus"></i> Invita</button>
            </form>
        }
    </section>

    <section v-show="activeTab === 'chat'" class="ordo-workspace-panel ordo-project-chat">
        <div class="ordo-workspace-panel-heading">
            <div>
                <h2>Chat</h2>
                <p>Conversazione con i collaboratori del progetto.</p>
            </div>
        </div>
        <div class="ordo-chat-messages">
            <p v-if="!messages.length" class="ordo-dashboard-empty">Nessun messaggio. Inizia la conversazione.</p>
            <article v-for="message in messages" :key="message.id"
                     class="ordo-chat-message" :class="{ mine: message.userId === currentUserId }">
                <header><strong>{{ message.userName }}</strong><time>{{ formatMessageDate(message.dataCreazione) }}</time></header>
                <p>{{ message.testo }}</p>
            </article>
        </div>
        <form method="post" action="@Url.Action(MVC.Progetti.Progetti.ChatInvia())" class="ordo-chat-form">
            <input type="hidden" name="ProjectId" value="@Model.Id" />
            <textarea name="Testo" maxlength="2000" rows="3" placeholder="Scrivi un messaggio..." required></textarea>
            <button class="ordo-btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Invia</button>
        </form>
    </section>

    <div v-if="taskModal.open" class="ordo-modal-backdrop" @@click.self="closeTaskModal">
        <section class="ordo-modal" role="dialog" aria-modal="true" aria-labelledby="taskModalTitle">
            <header class="ordo-modal-header">
                <h2 id="taskModalTitle">{{ taskModal.id ? 'Modifica attività' : 'Nuova attività' }}</h2>
                <button type="button" class="ordo-modal-close" @@click="closeTaskModal" aria-label="Chiudi">&times;</button>
            </header>
            <form method="post" action="@Url.Action("Edit", "Tasks", new { area = "Tasks" })"
                  class="ordo-project-form ordo-modal-form" v-on:submit.prevent="saveTask">
                <input type="hidden" name="Id" :value="taskModal.id" />
                <input type="hidden" name="BoardId" :value="taskModal.boardId" />
                <input type="hidden" name="ProjectId" value="@Model.Id" />
                <div class="ordo-field">
                    <label for="workspaceTaskTitle">Titolo</label>
                    <input id="workspaceTaskTitle" name="Titolo" v-model="taskModal.titolo" required autocomplete="off" />
                </div>
                <div class="ordo-field">
                    <label for="workspaceTaskDescription">Descrizione</label>
                    <textarea id="workspaceTaskDescription" name="Descrizione" v-model="taskModal.descrizione" rows="3"></textarea>
                </div>
                <div class="ordo-field-row">
                    <div class="ordo-field">
                        <label for="workspaceTaskPriority">Priorità</label>
                        <select id="workspaceTaskPriority" name="Priorita" v-model="taskModal.priorita">
                            <option value="0">Bassa</option>
                            <option value="1">Media</option>
                            <option value="2">Alta</option>
                        </select>
                    </div>
                    <div class="ordo-field">
                        <label for="workspaceTaskDueDate">Scadenza</label>
                        <input id="workspaceTaskDueDate" name="Scadenza" type="date" v-model="taskModal.scadenza" />
                    </div>
                </div>
                <div class="ordo-field">
                    <label for="workspaceTaskAssignee">Assegnato a</label>
                    <select id="workspaceTaskAssignee" name="AssignedUserId" v-model="taskModal.assignedUserId">
                        <option value="">Nessuna assegnazione</option>
                        <option v-for="member in members" :value="member.userId">{{ member.nomeCompleto }}</option>
                    </select>
                </div>
                <div class="ordo-project-form-actions">
                    <button type="button" class="ordo-btn-secondary" @@click="closeTaskModal">Annulla</button>
                    <button type="submit" class="ordo-btn-primary">Salva attività</button>
                </div>
            </form>
        </section>
    </div>
</div>

<script src="/js/bundle-vue.js" asp-append-version="true"></script>
<script src="/js/bundle-signalr.js" asp-append-version="true"></script>
<script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>
<script src="~/Areas/Progetti/ProjectWorkspace.js" asp-append-version="true"></script>
<script type="application/json" id="ProjectWorkspaceSeed">@Html.Raw(Model.ToJson())</script>
<script>
    Ordo.ProjectWorkspace.create(
        JSON.parse(document.getElementById("ProjectWorkspaceSeed").textContent),
        "@activeTab",
        "@currentUserId",
        "@Url.Action("MoveTask", "Kanban", new { area = "Kanban" })",
        "@Model.Id"
    );
</script>
