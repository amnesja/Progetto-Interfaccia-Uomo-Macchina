@model Ordo.Web.Areas.Progetti.DettaglioViewModel
@using System.Security.Claims
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.Nome;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@section styles {
    <link href="~/css/dashboard.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/progetti.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/signalr-banner.css" asp-append-version="true" rel="stylesheet" />
}

<div id="lostConnection" class="ordo-signalr-banner d-none">
    <i class="fa-solid fa-triangle-exclamation"></i> Connessione in tempo reale persa, riconnessione in corso...
</div>
<div id="lostConnectionManualRetry" class="ordo-signalr-banner ordo-signalr-banner-error d-none">
    <i class="fa-solid fa-plug-circle-xmark"></i> Impossibile riconnettersi.
    <a href="javascript:location.reload()">Ricarica la pagina</a>
</div>

@if (Context.Request.Query["notice"] == "board-deleted")
{
    <div class="ordo-realtime-notice">
        <i class="fa-solid fa-triangle-exclamation"></i>
        La board che stavi visualizzando è stata eliminata.
    </div>
}

<div class="ordo-projects-page">
    <a class="ordo-back-link" href="@Url.Action(MVC.Progetti.Progetti.Index())">
        <i class="fa-solid fa-arrow-left"></i> Torna ai progetti
    </a>

    <header class="ordo-project-detail-heading">
        <div>
            <span class="ordo-eyebrow">Progetto</span>
            <h1 id="ordoProjectTitle">@Model.Nome</h1>
            <p id="ordoProjectDescription">@(string.IsNullOrWhiteSpace(Model.Descrizione) ? "Nessuna descrizione." : Model.Descrizione)</p>
            <span class="ordo-role-badge">@(Model.IsOwner ? "Proprietario" : "Collaboratore")</span>
        </div>
        @if (Model.IsOwner)
        {
            <a class="ordo-btn-secondary" href="@Url.Action(MVC.Progetti.Progetti.Edit(Model.Id))">
                <i class="fa-solid fa-pen"></i> Modifica progetto
            </a>
        }
    </header>

    <section class="ordo-dashboard-section" id="ordoBoardsSection">
        <div class="ordo-section-title">
            <h2>Board</h2>
            <span>@Model.Boards.Count() board in questo progetto</span>
        </div>

        @if (!Model.Boards.Any())
        {
            <div class="ordo-dashboard-empty" id="ordoBoardsEmpty">Nessuna board creata. Aggiungine una per iniziare a organizzare i task.</div>
        }
        else
        {
            <div class="ordo-board-list" id="ordoBoardList">
                @foreach (var board in Model.Boards)
                {
                    <div class="ordo-board-row" data-board-id="@board.Id">
                        @if (Model.IsOwner)
                        {
                            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.BoardSalva())" class="ordo-board-inline-form">
                                <input type="hidden" name="Id" value="@board.Id" />
                                <input type="hidden" name="ProjectId" value="@Model.Id" />
                                <i class="fa-solid fa-table-columns"></i>
                                <input type="text" name="Nome" value="@board.Nome" autocomplete="off" />
                                <button type="submit" title="Salva nome board"><i class="fa-solid fa-check"></i></button>
                            </form>
                            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.BoardElimina())"
                                  onsubmit="return confirm('Eliminare questa board e tutti i suoi task?');">
                                <input type="hidden" name="id" value="@board.Id" />
                                <input type="hidden" name="projectId" value="@Model.Id" />
                                <button type="submit" class="ordo-link-danger" title="Elimina board"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                        else
                        {
                            <div class="ordo-board-inline-form">
                                <i class="fa-solid fa-table-columns"></i>
                                <span><strong>@board.Nome</strong></span>
                            </div>
                        }

                        <a class="ordo-btn-secondary ordo-board-open-link"
                           asp-area="Kanban"
                           asp-controller="Kanban"
                           asp-action="Board"
                           asp-route-id="@board.Id">
                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Apri board
                        </a>
                    </div>
                }
            </div>
        }

        @if (Model.IsOwner)
        {
            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.BoardSalva())" class="ordo-board-add-form">
                <input type="hidden" name="ProjectId" value="@Model.Id" />
                <input type="text" name="Nome" placeholder="Nome nuova board (es. Sprint 1)" autocomplete="off" required />
                <button type="submit"><i class="fa-solid fa-plus"></i> Aggiungi board</button>
            </form>
        }
        
        <script src="/js/bundle-signalr.js" asp-append-version="true"></script>
        <script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>
        <script type="text/javascript">
            var isOwner = @Model.IsOwner.ToString().ToLower();
            var boardSalvaUrl = "@Url.Action(MVC.Progetti.Progetti.BoardSalva())";
            var boardEliminaUrl = "@Url.Action(MVC.Progetti.Progetti.BoardElimina())";

            function escapeHtml(str) {
                var div = document.createElement("div");
                div.textContent = str || "";
                return div.innerHTML;
            }

            var signalRManager = new SignalRConnectionManager("/OrdoHub", "@Model.Id", "JoinGroup", "LeaveGroup");
            signalRManager.registerEvents();

            signalRManager.connection.on("BoardCreated", function (projectId, boardId, nome) {
                if (document.querySelector('[data-board-id="' + boardId + '"]')) return;

                var empty = document.getElementById("ordoBoardsEmpty");
                if (empty) empty.remove();

                var list = document.getElementById("ordoBoardList");
                if (!list) {
                    list = document.createElement("div");
                    list.className = "ordo-board-list";
                    list.id = "ordoBoardList";
                    document.getElementById("ordoBoardsSection").insertBefore(list, document.querySelector(".ordo-board-add-form"));
                }

                var row = document.createElement("div");
                row.className = "ordo-board-row";
                row.setAttribute("data-board-id", boardId);

                var formHtml;
                if (isOwner) {
                    formHtml =
                        '<form method="post" action="' + boardSalvaUrl + '" class="ordo-board-inline-form">' +
                        '<input type="hidden" name="Id" value="' + boardId + '" />' +
                        '<input type="hidden" name="ProjectId" value="@Model.Id" />' +
                        '<i class="fa-solid fa-table-columns"></i>' +
                        '<input type="text" name="Nome" value="' + escapeHtml(nome) + '" autocomplete="off" />' +
                        '<button type="submit" title="Salva nome board"><i class="fa-solid fa-check"></i></button>' +
                        '</form>' +
                        '<form method="post" action="' + boardEliminaUrl + '" onsubmit="return confirm(\'Eliminare questa board e tutti i suoi task?\');">' +
                        '<input type="hidden" name="id" value="' + boardId + '" />' +
                        '<input type="hidden" name="projectId" value="@Model.Id" />' +
                        '<button type="submit" class="ordo-link-danger" title="Elimina board"><i class="fa-solid fa-trash"></i></button>' +
                        '</form>';
                } else {
                    formHtml = '<div class="ordo-board-inline-form"><i class="fa-solid fa-table-columns"></i> ' + escapeHtml(nome) + '</div>';
                }

                // ← QUESTA riga mancava: il bottone "Apri board", per questo dopo la creazione live non lo vedevi
                formHtml += '<a class="ordo-btn-secondary ordo-board-open-link" href="/Kanban/Board/' + boardId + '">' +
                    '<i class="fa-solid fa-arrow-up-right-from-square"></i> Apri board</a>';

                row.innerHTML = formHtml;
                list.appendChild(row);
            });

            signalRManager.connection.on("BoardDeleted", function (projectId, boardId, nome) {
                var row = document.querySelector('[data-board-id="' + boardId + '"]');
                if (row) row.remove();
            });

            signalRManager.connection.on("BoardUpdated", function (projectId, boardId, nome) {
                var row = document.querySelector('[data-board-id="' + boardId + '"]');
                if (!row) return;

                var input = row.querySelector('input[name="Nome"]');
                if (input) {
                    input.value = nome;
                } else {
                    var span = row.querySelector(".ordo-board-inline-form");
                    if (span) span.innerHTML = '<i class="fa-solid fa-table-columns"></i> ' + escapeHtml(nome);
                }
            });

            signalRManager.connection.on("ProjectUpdated", function (projectId, nome, descrizione) {
                if (projectId !== "@Model.Id") return;

                var titleEl = document.getElementById("ordoProjectTitle");
                if (titleEl) titleEl.textContent = nome;

                var descEl = document.getElementById("ordoProjectDescription");
                if (descEl) descEl.textContent = descrizione || "Nessuna descrizione.";
            });

            signalRManager.connection.on("ProjectDeleted", function (projectId) {
                window.location = "@Url.Action(MVC.Progetti.Progetti.Index())?notice=project-deleted";
            });

            signalRManager.connection.on("MemberRemoved", function (projectId, userId) {
                var row = document.querySelector('[data-member-id="' + userId + '"]');
                if (row) row.remove();

                if (userId === "@currentUserId") {
                    window.location = "@Url.Action(MVC.Progetti.Progetti.Index())?notice=removed-from-project";
                }
            });

            signalRManager.connection.on("TaskChangedForUser", function (tipo, titolo, projectNome, projectId, boardId) {
                if (tipo !== "Assigned") return;
                if (projectId === "@Model.Id") return; // sei già sul dettaglio di questo stesso progetto

                Ordo.Toast.showAssigned(titolo, projectNome);
            });

            signalRManager.startConnection().then(function () {
                signalRManager.connection.invoke("JoinGroup", "@currentUserId");
            });
            
        </script>        
        
    </section>

    <section class="ordo-dashboard-section">
        <div class="ordo-section-title">
            <h2>Collaboratori</h2>
            <span>@Model.Membri.Count() invitati, oltre al proprietario</span>
        </div>

        @if (!Model.Membri.Any())
        {
            <div class="ordo-dashboard-empty">Nessun collaboratore invitato. Solo tu puoi vedere questo progetto per ora.</div>
        }
        else
        {
            <div class="ordo-board-list">
                @foreach (var membro in Model.Membri)
                {
                    <div class="ordo-board-row" data-member-id="@membro.UserId">
                        <div class="ordo-member-info">
                            <span class="ordo-member-avatar">@membro.NomeCompleto.Substring(0, 1).ToUpper()</span>
                            <div>
                                <strong>@membro.NomeCompleto</strong>
                                <small>@membro.Email</small>
                            </div>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.MembroRimuovi())"
                                  onsubmit="return confirm('Rimuovere questo collaboratore dal progetto?');">
                                <input type="hidden" name="projectId" value="@Model.Id" />
                                <input type="hidden" name="userId" value="@membro.UserId" />
                                <button type="submit" class="ordo-link-danger" title="Rimuovi collaboratore"><i class="fa-solid fa-user-minus"></i></button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.IsOwner)
        {
            <form method="post" action="@Url.Action(MVC.Progetti.Progetti.MembroAggiungi())" class="ordo-board-add-form">
                <input type="hidden" name="ProjectId" value="@Model.Id" />
                <input type="email" name="Email" placeholder="Email del collaboratore da invitare" autocomplete="off" required />
                <button type="submit"><i class="fa-solid fa-user-plus"></i> Invita</button>
            </form>
        }
    </section>

</div>