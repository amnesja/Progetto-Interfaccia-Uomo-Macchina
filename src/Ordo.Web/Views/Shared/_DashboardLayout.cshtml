@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Ordo.Services
@using Ordo.Services.Shared
@inject OrdoDbContext SidebarDbContext
@{
    Layout = "_LayoutHtml";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var identitaCorrente = ViewData[Ordo.Web.Areas.IdentitaViewModel.VIEWDATA_IDENTITACORRENTE_KEY] as Ordo.Web.Areas.IdentitaViewModel;
    var title = ViewData["Title"]?.ToString() ?? "Ordo";
    var projectId = ViewData["BreadcrumbProjectId"]?.ToString();
    var boardId = ViewData["BreadcrumbBoardId"]?.ToString();
    var projectName = ViewData["BreadcrumbProjectName"]?.ToString();
    var boardName = ViewData["BreadcrumbBoardName"]?.ToString();
    var isDashboard = string.IsNullOrEmpty(area) && controller == "Dashboard";
    var isProjects = area == "Progetti" && controller == "Progetti";
    var isActivities = string.IsNullOrEmpty(area) && controller == "Attivita";
    var isKanban = area == "Kanban";
    var isTasks = area == "Tasks";
    var emailPrefix = identitaCorrente?.EmailUtenteCorrente?.Split('@')[0] ?? "?";
    var userInitials = emailPrefix.Length >= 2 ? emailPrefix[..2].ToUpperInvariant() : emailPrefix.ToUpperInvariant();
    var sidebarUserId = Guid.TryParse(currentUserId, out var parsedSidebarUserId) ? parsedSidebarUserId : Guid.Empty;
    var sidebarProjects = sidebarUserId == Guid.Empty
        ? new List<dynamic>()
        : (await SidebarDbContext.Projects
            .AsNoTracking()
            .Where(x => x.OwnerId == sidebarUserId || x.Members.Any(member => member.UserId == sidebarUserId))
            .OrderBy(x => x.Nome)
            .Select(x => new { x.Id, x.Nome })
            .ToListAsync()).Cast<dynamic>().ToList();
    var sidebarTaskCounts = sidebarUserId == Guid.Empty
        ? new Dictionary<TaskState, int>()
        : (await SidebarDbContext.Tasks
            .AsNoTracking()
            .Where(x => x.AssignedUserId == sidebarUserId)
            .Select(x => x.Stato)
            .ToListAsync())
            .GroupBy(state => state)
            .ToDictionary(group => group.Key, group => group.Count());
    var activityFilter = ViewContext.HttpContext.Request.Query["filtro"].ToString();

    int SidebarTaskCount(TaskState state) => sidebarTaskCounts.TryGetValue(state, out var count) ? count : 0;
}

@section styles {
    <link href="~/css/dashboard.css" asp-append-version="true" rel="stylesheet" />
    @RenderSection("styles", required: false)
}

<div class="ordo-dashboard-shell">
    <header class="ordo-dashboard-topbar">
        <a class="ordo-brand" asp-area="" asp-controller="Dashboard" asp-action="Index" aria-label="Ordo, dashboard">
            <span class="ordo-brand-mark">O</span><span>Ordo</span>
        </a>

        <div class="ordo-dashboard-context">
            <nav class="ordo-breadcrumb" aria-label="Percorso">
                <a asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>

                @if (projectId != null)
                {
                    <span aria-hidden="true">/</span>
                    <a asp-area="Progetti" asp-controller="Progetti" asp-action="Dettaglio" asp-route-id="@projectId">
                        @(string.IsNullOrWhiteSpace(projectName) ? "Progetto" : projectName)
                    </a>
                }

                @if (boardId != null)
                {
                    <span aria-hidden="true">/</span>
                    <a asp-area="Kanban" asp-controller="Kanban" asp-action="Board" asp-route-id="@boardId">
                        @(string.IsNullOrWhiteSpace(boardName) ? "Board" : boardName)
                    </a>
                }

                @if (!isDashboard && !isProjects && projectId == null && !isActivities)
                {
                    <span aria-hidden="true">/</span>
                    <span>@title</span>
                }
                else if (isProjects && projectId == null)
                {
                    <span aria-hidden="true">/</span>
                    <span>@title</span>
                }
                else if (isActivities)
                {
                    <span aria-hidden="true">/</span>
                    <span>Attività</span>
                }
                else if (projectId != null && boardId == null && !isProjects)
                {
                    <span aria-hidden="true">/</span>
                    <span>@title</span>
                }
                else if (boardId != null && isTasks)
                {
                    <span aria-hidden="true">/</span>
                    <span>@title</span>
                }
            </nav>
        </div>

        <div class="ordo-dashboard-topbar-actions">
            <div class="ordo-notification-center">
                <button id="notificationBell" class="ordo-notification-bell" type="button" aria-label="Apri notifiche" aria-expanded="false">
                    <i class="fa-regular fa-bell"></i><span id="notificationPreview"></span><span id="notificationBadge" class="d-none">0</span>
                </button>
                <div id="notificationPanel" class="ordo-notification-panel d-none" role="status" aria-live="polite">
                    <header><strong>Notifiche</strong><button id="clearNotifications" type="button">Segna come lette</button></header>
                    <div id="notificationList"><p>Nessuna notifica.</p></div>
                </div>
            </div>
            @if (identitaCorrente != null)
            {
                <div class="ordo-user-menu">
                    <button id="userMenuButton" class="ordo-user-menu-button" type="button" aria-label="Apri menu utente" aria-expanded="false" aria-controls="userMenuPanel">
                        <span aria-hidden="true">@userInitials</span>
                    </button>
                    <div id="userMenuPanel" class="ordo-user-menu-panel d-none">
                        <div class="ordo-user-menu-profile">
                            <span class="ordo-user-menu-avatar">@userInitials</span>
                            <div><strong>@emailPrefix</strong><small>@identitaCorrente.EmailUtenteCorrente</small></div>
                        </div>
                        <a asp-area="" asp-controller="Profile" asp-action="Profile"><i class="fa-regular fa-user"></i> Profilo</a>
                        <form asp-area="" asp-controller="Login" asp-action="Logout" method="post">
                            <button type="submit"><i class="fa-solid fa-arrow-right-from-bracket"></i> Esci</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </header>

    <button class="ordo-sidebar-backdrop" type="button" aria-label="Chiudi il menu" data-sidebar-close hidden></button>
    <aside id="ordoDashboardSidebar" class="ordo-dashboard-sidebar" aria-label="Navigazione principale">
        <button class="ordo-sidebar-close" type="button" aria-label="Chiudi il menu" data-sidebar-close>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i><span>Chiudi</span>
        </button>
        <nav class="ordo-dashboard-nav" aria-label="Navigazione principale">
            <a class="@(isDashboard ? "active" : "")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span>
            </a>
            <section class="ordo-sidebar-group ordo-sidebar-group-pinned @(isActivities ? "is-current" : "")" data-sidebar-accordion>
                <button type="button" class="ordo-sidebar-group-toggle" aria-expanded="@(isActivities ? "true" : "false")">
                    <span><i class="fa-solid fa-list-check"></i><span>Attività</span></span>
                    <i class="fa-solid fa-chevron-down ordo-sidebar-chevron"></i>
                </button>
                <div class="ordo-sidebar-group-items" @(isActivities ? "" : "hidden")>
                    <a class="@(isActivities && string.IsNullOrEmpty(activityFilter) ? "active" : "")"
                       data-sidebar-activity-filter=""
                       asp-area="" asp-controller="Attivita" asp-action="Index">
                        <i class="fa-solid fa-layer-group"></i><span>Tutte</span>
                    </a>
                    <a class="@(isActivities && activityFilter == TaskState.ToDo.ToString() ? "active" : "")"
                       data-sidebar-activity-filter="@TaskState.ToDo"
                       asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.ToDo">
                        <i class="fa-regular fa-circle"></i><span>Da fare</span><b>@SidebarTaskCount(TaskState.ToDo)</b>
                    </a>
                    <a class="@(isActivities && activityFilter == TaskState.InProgress.ToString() ? "active" : "")"
                       data-sidebar-activity-filter="@TaskState.InProgress"
                       asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.InProgress">
                        <i class="fa-solid fa-spinner"></i><span>In corso</span><b>@SidebarTaskCount(TaskState.InProgress)</b>
                    </a>
                    <a class="@(isActivities && activityFilter == TaskState.Review.ToString() ? "active" : "")"
                       data-sidebar-activity-filter="@TaskState.Review"
                       asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.Review">
                        <i class="fa-solid fa-magnifying-glass"></i><span>Review</span><b>@SidebarTaskCount(TaskState.Review)</b>
                    </a>
                    <a class="@(isActivities && activityFilter == TaskState.Done.ToString() ? "active" : "")"
                       data-sidebar-activity-filter="@TaskState.Done"
                       asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.Done">
                        <i class="fa-regular fa-circle-check"></i><span>Completate</span><b>@SidebarTaskCount(TaskState.Done)</b>
                    </a>
                </div>
            </section>

            <div class="ordo-sidebar-scroll">
                <section class="ordo-sidebar-group @(area == "Progetti" || isKanban || isTasks ? "is-current" : "")" data-sidebar-accordion>
                    <button type="button" class="ordo-sidebar-group-toggle" aria-expanded="@(area == "Progetti" || isKanban || isTasks ? "true" : "false")">
                        <span><i class="fa-regular fa-folder"></i><span>Progetti</span></span>
                        <i class="fa-solid fa-chevron-down ordo-sidebar-chevron"></i>
                    </button>
                    <div class="ordo-sidebar-group-items" @(area == "Progetti" || isKanban || isTasks ? "" : "hidden")>
                        @if (sidebarProjects.Count == 0)
                        {
                            <span class="ordo-sidebar-empty">Nessun progetto</span>
                        }
                        else
                        {
                            foreach (var project in sidebarProjects)
                            {
                                <a class="@(projectId == project.Id.ToString() ? "active" : "")"
                                   asp-area="Progetti" asp-controller="Progetti" asp-action="Dettaglio" asp-route-id="@project.Id">
                                    <i class="fa-regular fa-folder-open"></i><span>@project.Nome</span>
                                </a>
                            }
                        }
                    </div>
                </section>
            </div>
        </nav>

        <div class="ordo-sidebar-footer">
            <div class="ordo-sidebar-hint"><i class="fa-regular fa-circle-question"></i><span>Gestisci il lavoro del tuo team in un unico posto.</span></div>
        </div>
    </aside>

    <main class="ordo-dashboard-main">
        @if (ViewData[Alerts.ALERTS_KEY] is AlertsDto alerts)
        {
            foreach (var alert in alerts.List)
            {
                <div class="ordo-dashboard-alert ordo-dashboard-alert-@alert.Level" role="alert">
                    <i class="fa-solid @(alert.Level == AlertsDto.AlertLevelEnum.success ? "fa-circle-check" : alert.Level == AlertsDto.AlertLevelEnum.error ? "fa-circle-exclamation" : "fa-circle-info")"></i>
                    <span>@alert.Value</span>
                </div>
            }
        }
        @RenderBody()
    </main>

    <nav class="ordo-mobile-nav" aria-label="Navigazione mobile">
        <a class="@(isDashboard ? "active" : "")" data-page-current="@(isDashboard ? "true" : "false")" asp-area="" asp-controller="Dashboard" asp-action="Index"><i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
        <button type="button" aria-controls="ordoMobileProjects ordoDashboardSidebar" aria-expanded="false" data-page-current="@(area == "Progetti" || isKanban || isTasks ? "true" : "false")" data-sidebar-group="projects" class="@(area == "Progetti" || isKanban || isTasks ? "active" : "")"><i class="fa-regular fa-folder"></i><span>Progetti</span></button>
        <button type="button" aria-controls="ordoMobileActivities ordoDashboardSidebar" aria-expanded="false" data-page-current="@(isActivities ? "true" : "false")" data-sidebar-group="activities" class="@(isActivities ? "active" : "")"><i class="fa-solid fa-list-check"></i><span>Attività</span></button>
    </nav>

    <button class="ordo-mobile-panel-backdrop" type="button" aria-label="Chiudi il pannello" data-mobile-panel-close hidden></button>
    <section id="ordoMobileActivities" class="ordo-mobile-panel" aria-labelledby="ordoMobileActivitiesTitle" hidden>
        <header>
            <h2 id="ordoMobileActivitiesTitle">Attività</h2>
            <button type="button" aria-label="Chiudi Attività" data-mobile-panel-close><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        <nav aria-label="Filtri attività">
            <a class="@(isActivities && string.IsNullOrEmpty(activityFilter) ? "active" : "")" asp-area="" asp-controller="Attivita" asp-action="Index">
                <i class="fa-solid fa-layer-group"></i><span>Tutte</span>
            </a>
            <a class="@(isActivities && activityFilter == TaskState.ToDo.ToString() ? "active" : "")" asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.ToDo">
                <i class="fa-regular fa-circle"></i><span>Da fare</span><b>@SidebarTaskCount(TaskState.ToDo)</b>
            </a>
            <a class="@(isActivities && activityFilter == TaskState.InProgress.ToString() ? "active" : "")" asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.InProgress">
                <i class="fa-solid fa-spinner"></i><span>In corso</span><b>@SidebarTaskCount(TaskState.InProgress)</b>
            </a>
            <a class="@(isActivities && activityFilter == TaskState.Review.ToString() ? "active" : "")" asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.Review">
                <i class="fa-solid fa-magnifying-glass"></i><span>Review</span><b>@SidebarTaskCount(TaskState.Review)</b>
            </a>
            <a class="@(isActivities && activityFilter == TaskState.Done.ToString() ? "active" : "")" asp-area="" asp-controller="Attivita" asp-action="Index" asp-route-filtro="@TaskState.Done">
                <i class="fa-regular fa-circle-check"></i><span>Completate</span><b>@SidebarTaskCount(TaskState.Done)</b>
            </a>
        </nav>
    </section>
    <section id="ordoMobileProjects" class="ordo-mobile-panel" aria-labelledby="ordoMobileProjectsTitle" hidden>
        <header>
            <h2 id="ordoMobileProjectsTitle">Progetti</h2>
            <button type="button" aria-label="Chiudi Progetti" data-mobile-panel-close><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </header>
        <nav aria-label="Progetti">
            @if (sidebarProjects.Count == 0)
            {
                <span class="ordo-mobile-panel-empty">Nessun progetto</span>
            }
            else
            {
                foreach (var project in sidebarProjects)
                {
                    <a class="@(projectId == project.Id.ToString() ? "active" : "")" asp-area="Progetti" asp-controller="Progetti" asp-action="Dettaglio" asp-route-id="@project.Id">
                        <i class="fa-regular fa-folder-open"></i><span>@project.Nome</span>
                    </a>
                }
            }
        </nav>
    </section>
</div>

@section scripts {
    <script>
        var dashboardSidebar = document.getElementById("ordoDashboardSidebar");
        var sidebarBackdrop = document.querySelector(".ordo-sidebar-backdrop");
        var mobileNavigation = window.matchMedia("(max-width: 900px)");
        var phoneNavigation = window.matchMedia("(max-width: 640px)");
        var sidebarReturnFocus = null;
        var mobilePanelReturnFocus = null;

        function closeMobilePanel(restoreFocus, restorePageState) {
            document.querySelectorAll(".ordo-mobile-panel").forEach(function (panel) { panel.hidden = true; });
            document.querySelector(".ordo-mobile-panel-backdrop").hidden = true;
            document.querySelectorAll(".ordo-mobile-nav [data-sidebar-group]").forEach(function (button) { button.setAttribute("aria-expanded", "false"); });
            document.querySelectorAll(".ordo-mobile-nav [data-page-current]").forEach(function (item) { item.classList.remove("active"); });
            if (restorePageState) {
                document.querySelectorAll('.ordo-mobile-nav [data-page-current="true"]').forEach(function (item) { item.classList.add("active"); });
            }
            document.body.classList.remove("ordo-mobile-panel-open");
            if (restoreFocus && mobilePanelReturnFocus) mobilePanelReturnFocus.focus();
            mobilePanelReturnFocus = null;
        }

        function openMobilePanel(groupName, trigger) {
            var panel = document.getElementById(groupName === "activities" ? "ordoMobileActivities" : "ordoMobileProjects");
            var isAlreadyOpen = !panel.hidden;
            closeMobilePanel(false, isAlreadyOpen);
            if (isAlreadyOpen) return;

            mobilePanelReturnFocus = trigger;
            panel.hidden = false;
            document.querySelector(".ordo-mobile-panel-backdrop").hidden = false;
            document.querySelectorAll(".ordo-mobile-nav [data-page-current]").forEach(function (item) { item.classList.remove("active"); });
            trigger.classList.add("active");
            trigger.setAttribute("aria-expanded", "true");
            document.body.classList.add("ordo-mobile-panel-open");
            panel.querySelector("[data-mobile-panel-close]").focus();
        }

        function setSidebarOpen(open, groupName) {
            if (!dashboardSidebar || !mobileNavigation.matches) return;

            document.querySelectorAll(".ordo-mobile-nav [data-page-current]").forEach(function (item) { item.classList.remove("active"); });
            if (open && groupName) {
                document.querySelector('.ordo-mobile-nav [data-sidebar-group="' + groupName + '"]')?.classList.add("active");
            } else if (!open) {
                document.querySelectorAll('.ordo-mobile-nav [data-page-current="true"]').forEach(function (item) { item.classList.add("active"); });
            }

            dashboardSidebar.classList.toggle("is-open", open);
            dashboardSidebar.setAttribute("aria-hidden", String(!open));
            dashboardSidebar.inert = !open;
            sidebarBackdrop.hidden = !open;
            document.body.classList.toggle("ordo-sidebar-open", open);

            document.querySelectorAll("[data-sidebar-open], [data-sidebar-group]").forEach(function (button) {
                button.setAttribute("aria-expanded", String(open && (button.dataset.sidebarOpen !== undefined || button.dataset.sidebarGroup === groupName)));
            });

            if (groupName) {
                document.querySelectorAll("[data-sidebar-accordion]").forEach(function (group) {
                    var isTarget = group.classList.contains("ordo-sidebar-group-pinned") === (groupName === "activities");
                    var toggle = group.querySelector(".ordo-sidebar-group-toggle");
                    var items = group.querySelector(".ordo-sidebar-group-items");
                    toggle.setAttribute("aria-expanded", String(isTarget));
                    items.hidden = !isTarget;
                });
            }

            if (open) {
                sidebarReturnFocus = document.activeElement;
                dashboardSidebar.querySelector("[data-sidebar-close]").focus();
            } else if (sidebarReturnFocus) {
                sidebarReturnFocus.focus();
                sidebarReturnFocus = null;
            }
        }

        document.querySelectorAll("[data-sidebar-open]").forEach(function (button) {
            button.addEventListener("click", function () { setSidebarOpen(true); });
        });
        document.querySelectorAll("[data-sidebar-group]").forEach(function (button) {
            button.addEventListener("click", function () {
                if (phoneNavigation.matches) openMobilePanel(button.dataset.sidebarGroup, button);
                else setSidebarOpen(true, button.dataset.sidebarGroup);
            });
        });
        document.querySelectorAll("[data-sidebar-close]").forEach(function (button) {
            button.addEventListener("click", function () { setSidebarOpen(false); });
        });
        dashboardSidebar.querySelectorAll("a").forEach(function (link) {
            link.addEventListener("click", function () { setSidebarOpen(false); });
        });
        document.querySelectorAll(".ordo-mobile-panel [data-mobile-panel-close]").forEach(function (button) {
            button.addEventListener("click", function () { closeMobilePanel(true, true); });
        });
        document.querySelector(".ordo-mobile-panel-backdrop").addEventListener("click", function () { closeMobilePanel(true, true); });
        document.querySelectorAll(".ordo-mobile-panel a").forEach(function (link) {
            link.addEventListener("click", function () { closeMobilePanel(false); });
        });
        phoneNavigation.addEventListener("change", function () { closeMobilePanel(false, true); });
        mobileNavigation.addEventListener("change", function () {
            dashboardSidebar.classList.remove("is-open");
            dashboardSidebar.removeAttribute("aria-hidden");
            dashboardSidebar.inert = false;
            sidebarBackdrop.hidden = true;
            document.body.classList.remove("ordo-sidebar-open");
        });

        document.querySelectorAll("[data-sidebar-accordion] .ordo-sidebar-group-toggle").forEach(function (toggle) {
            toggle.addEventListener("click", function () {
                var group = toggle.closest("[data-sidebar-accordion]");
                var isExpanded = toggle.getAttribute("aria-expanded") === "true";
                document.querySelectorAll("[data-sidebar-accordion]").forEach(function (otherGroup) {
                    otherGroup.querySelector(".ordo-sidebar-group-toggle").setAttribute("aria-expanded", "false");
                    otherGroup.querySelector(".ordo-sidebar-group-items").hidden = true;
                });
                if (!isExpanded) {
                    toggle.setAttribute("aria-expanded", "true");
                    group.querySelector(".ordo-sidebar-group-items").hidden = false;
                }
            });
        });

        document.querySelectorAll(".ordo-dashboard-alert").forEach(function (alert) {
            window.setTimeout(function () { alert.classList.add("is-dismissing"); window.setTimeout(function () { alert.remove(); }, 400); }, 5000);
        });

        document.addEventListener("keydown", function (event) {
            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
                event.preventDefault();
                document.querySelector(".ordo-global-search input")?.focus();
            }
            if (event.key === "Escape") {
                setSidebarOpen(false);
                closeMobilePanel(true, true);
                document.getElementById("notificationPanel")?.classList.add("d-none");
                document.getElementById("userMenuPanel")?.classList.add("d-none");
            }
        });
    </script>
    <script src="/js/bundle-signalr.js" asp-append-version="true"></script>
    <script src="~/js/signalRConnectionManager.js" asp-append-version="true"></script>
    <script>
        (function () {
            var storageKey = "ordo:notifications:@currentUserId";
            var notifications = JSON.parse(sessionStorage.getItem(storageKey) || "[]");
            var bell = document.getElementById("notificationBell");
            var badge = document.getElementById("notificationBadge");
            var preview = document.getElementById("notificationPreview");
            var panel = document.getElementById("notificationPanel");
            var list = document.getElementById("notificationList");
            var recentNotifications = {};
            var previewTimer;

            function notificationDay(notification) {
                var date = notification.createdAt ? new Date(notification.createdAt) : new Date();
                var today = new Date();
                var yesterday = new Date(today);
                yesterday.setDate(today.getDate() - 1);
                if (date.toDateString() === today.toDateString()) return "Oggi";
                if (date.toDateString() === yesterday.toDateString()) return "Ieri";
                return date.toLocaleDateString("it-IT", { day: "numeric", month: "long" });
            }

            function renderNotifications() {
                list.replaceChildren();
                if (!notifications.length) {
                    var empty = document.createElement("p"); empty.textContent = "Nessuna notifica."; list.appendChild(empty);
                } else {
                    var groups = {};
                    notifications.forEach(function (notification) {
                        var day = notificationDay(notification);
                        if (!groups[day]) {
                            groups[day] = document.createElement("section");
                            groups[day].className = "ordo-notification-group";
                            var heading = document.createElement("h3");
                            heading.textContent = day;
                            groups[day].appendChild(heading);
                            list.appendChild(groups[day]);
                        }
                        var item = document.createElement(notification.url ? "a" : "article");
                        item.className = "ordo-notification-item";
                        if (notification.url) item.href = notification.url;
                        var icon = document.createElement("i");
                        icon.className = notification.icon === "chat" ? "fa-regular fa-comments" : notification.icon === "project" ? "fa-regular fa-folder" : notification.icon === "board" ? "fa-solid fa-table-columns" : "fa-solid fa-list-check";
                        var content = document.createElement("span"); content.className = "ordo-notification-content";
                        var text = document.createElement("strong"); text.textContent = notification.text;
                        var time = document.createElement("time"); time.textContent = notification.time;
                        content.append(text, time);
                        item.append(icon, content); groups[day].appendChild(item);
                    });
                }
                badge.textContent = notifications.length;
                badge.classList.toggle("d-none", notifications.length === 0);
                sessionStorage.setItem(storageKey, JSON.stringify(notifications));
            }
            function addNotification(text, url, icon) {
                notifications.unshift({ text:text, url:url, icon:icon, createdAt:Date.now(), time:new Date().toLocaleTimeString("it-IT", {hour:"2-digit", minute:"2-digit"}) });
                notifications = notifications.slice(0,20); renderNotifications();
                bell.classList.add("has-new");
                window.clearTimeout(bell.newNotificationTimer);
                bell.newNotificationTimer = window.setTimeout(function () {
                    bell.classList.remove("has-new");
                }, 1800);
            }
            function showNotificationPreview(text, duration) {
                window.clearTimeout(previewTimer);
                preview.textContent = text;
                bell.classList.add("is-preview");
                previewTimer = window.setTimeout(function () {
                    bell.classList.remove("is-preview");
                    preview.textContent = "";
                }, duration || 2800);
            }
            window.ordoNotify = function (text, url, icon, duration, callback) {
                var key = text + "|" + (url || "");
                var now = Date.now();
                var duplicate = recentNotifications[key] && now - recentNotifications[key] < 1500;
                recentNotifications[key] = now;

                if (!duplicate) {
                    addNotification(text, url, icon || "task");
                    showNotificationPreview(text);
                }

                if (typeof callback === "function") {
                    window.setTimeout(callback, duplicate ? 0 : duration || 1200);
                }
            };
            bell?.addEventListener("click", function (event) { event.stopPropagation(); var hidden = panel.classList.toggle("d-none"); bell.setAttribute("aria-expanded", (!hidden).toString()); });
            var userMenuButton = document.getElementById("userMenuButton");
            var userMenuPanel = document.getElementById("userMenuPanel");
            if (userMenuButton && userMenuPanel) {
                userMenuButton.addEventListener("click", function (event) { event.stopPropagation(); var hidden = userMenuPanel.classList.toggle("d-none"); userMenuButton.setAttribute("aria-expanded", (!hidden).toString()); });
                document.addEventListener("click", function () { userMenuPanel.classList.add("d-none"); userMenuButton.setAttribute("aria-expanded", "false"); panel?.classList.add("d-none"); });
            }
            document.getElementById("clearNotifications")?.addEventListener("click", function () { notifications=[]; renderNotifications(); });
            renderNotifications();

            var globalSignalR = new SignalRConnectionManager("/OrdoHub", "@currentUserId", "JoinGroup", "LeaveGroup");
            globalSignalR.registerEvents();
            globalSignalR.connection.on("TaskChangedForUser", function (tipo, titolo, projectNome, projectId, boardId, taskId) {
                var actions = {Assigned:"Ti è stata assegnata l'attività", Unassigned:"Non sei più assegnato all'attività", Updated:"Attività aggiornata", Deleted:"Attività eliminata", Commented:"Nuovo commento sull'attività", CommentDeleted:"Commento eliminato dall'attività"};
                var url = "/Progetti/Dettaglio/" + projectId + "?tab=board" + (tipo === "Deleted" ? "" : "&task=" + taskId);
                ordoNotify((actions[tipo] || "Attività aggiornata") + ": «" + titolo + "»" + (projectNome ? " · " + projectNome : ""), url, "task");
            });
            globalSignalR.connection.on("ProjectMemberAdded", function (projectId, nome) { ordoNotify("Sei stato aggiunto al progetto «" + nome + "».", "/Progetti/Dettaglio/" + projectId, "project"); });
            globalSignalR.connection.on("ProjectUpdated", function (projectId, nome) { ordoNotify("Il progetto «" + nome + "» è stato aggiornato.", "/Progetti/Dettaglio/" + projectId, "project"); });
            globalSignalR.connection.on("ProjectDeleted", function (projectId) {
                if (projectId) {
                    var deletedProjectUrl = "/Progetti/Dettaglio/" + projectId;
                    notifications = notifications.filter(function (notification) {
                        if (!notification.url) return true;
                        try {
                            var url = new URL(notification.url, window.location.origin);
                            return url.pathname.toLowerCase() !== deletedProjectUrl.toLowerCase();
                        } catch (_) {
                            return true;
                        }
                    });
                    renderNotifications();
                }
                ordoNotify("Un progetto non è più disponibile.", null, "project");
                // Ricarichiamo la pagina corrente ovunque ci si trovi (sidebar, contatori
                // e liste sono calcolati lato server): senza questo reload, restavano
                // aggiornati solo se ci si trovava già sulla Dashboard.
                location.reload();
            });
            globalSignalR.connection.on("ProjectChatMessageAdded", function (message) { ordoNotify("Nuovo messaggio da " + message.userName + ".", "/Progetti/Dettaglio/" + message.idGroup + "?tab=chat", "chat"); });
            globalSignalR.connection.on("BoardCreated", function (projectId, boardId, nome) { ordoNotify("È stata creata la board «" + nome + "».", "/Progetti/Dettaglio/" + projectId + "?tab=board", "board"); });
            globalSignalR.connection.on("BoardUpdated", function (projectId, boardId, nome) { ordoNotify("La board «" + nome + "» è stata aggiornata.", "/Progetti/Dettaglio/" + projectId + "?tab=board", "board"); });
            globalSignalR.connection.on("BoardDeleted", function (projectId) { ordoNotify("Una board non è più disponibile.", "/Progetti/Dettaglio/" + projectId + "?tab=board", "board"); });
            globalSignalR.startConnection();
        })();
    </script>
    @RenderSection("scripts", required: false)
}
